var compactObject = function(obj) {
    if (Array.isArray(obj)) {
        return obj
            .filter(value => Boolean(value))
            .map(value => 
                typeof value === "object" && value !== null
                    ? compactObject(value)
                    : value
            );
    }

    const result = {};

    for (const key in obj) {
        if (Boolean(obj[key])) {
            result[key] =
                typeof obj[key] === "object" && obj[key] !== null
                    ? compactObject(obj[key])
                    : obj[key];
        }
    }

    return result;
};
